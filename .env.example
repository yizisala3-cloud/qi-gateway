# 网关鉴权 token（橘瓣填的 API Key）
GATEWAY_TOKEN=your_gateway_token

# 上游 LLM
UPSTREAM_BASE_URL=https://your-llm-provider.com/v1
UPSTREAM_API_KEY=your_upstream_api_key
UPSTREAM_MODEL=claude-sonnet-4-20250514

# Supabase
SUPABASE_URL=https://dlgunkklpjqletgahdtp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
# 可选：新版服务端 secret key；配置时优先于 service_role
# SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_KEY=your_supabase_publishable_key

# 情绪分析 + 记忆提取
ANALYSIS_BASE_URL=https://api.siliconflow.cn/v1
ANALYSIS_API_KEY=your_analysis_api_key
ANALYSIS_MODEL=Qwen/Qwen2.5-7B-Instruct

# 记忆总结（均可选）
# 留空会从 chat_messages 的最新有效记录自动发现
MEMORY_ASSISTANT_ID=
MEMORY_DIGEST_MAX_MESSAGES=60
MEMORY_DIGEST_MAX_CHARS=12000
MEMORY_DIGEST_IDLE_HOURS=6

PORT=8000

