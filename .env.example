# 网关鉴权 token（橘瓣填的 API Key）
GATEWAY_TOKEN=your_gateway_token

# 上游 LLM
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=your_upstream_api_key
UPSTREAM_MODEL=deepseek-v4-pro
# Gemini 浏览器代理工具历史兼容；仅当最终模型名以 gemini- 开头时生效
# DeepSeek、Claude、Qwen、OpenAI 等上游应保持 false
GEMINI_BROWSER_TOOL_COMPAT_ENABLED=false

# Supabase
SUPABASE_URL=https://dlgunkklpjqletgahdtp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
# 可选：新版服务端 secret key；配置时优先于 service_role
# SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_KEY=your_supabase_publishable_key

# 记忆检索与旧版自动总结（硅基流动）
# ANALYSIS_* 用于旧版自动总结/普通记忆提取和 embedding
ANALYSIS_BASE_URL=https://api.siliconflow.cn/v1
ANALYSIS_API_KEY=your_analysis_api_key
ANALYSIS_MODEL=Qwen/Qwen2.5-7B-Instruct

# 连续感总结与 Shadow Preview 的独立文本提取模型
# 必须提供 OpenAI-compatible /chat/completions 接口；留空表示未配置，
# 不会回退复用 ANALYSIS_*
CONTINUITY_BASE_URL=https://your-continuity-provider.example/v1
CONTINUITY_API_KEY=your_continuity_api_key
CONTINUITY_MODEL=your_continuity_model
# 连续感文本提取最大输出 token 数；推理模型需要足够预算完成 reasoning 和 JSON 输出
# 允许范围 1024-120000，越界按边界钳制；非整数或留空使用默认 8192
# 该预算同时用于连续感正式总结和 Shadow Preview；不影响旧版自动总结，也不影响 embedding
# 如需 12 万预算，在 Zeabur 中设置 CONTINUITY_MAX_TOKENS=120000
# 若供应商的模型或套餐实际上限低于设定值，请改成供应商允许的值
CONTINUITY_MAX_TOKENS=8192

# 反刍连续感路径的独立提取模型（可选；留空回退复用 CONTINUITY_*）
# 反刍每天 Asia/Shanghai 06:00 自动运行一次，独立游标与运行记录，
# 与连续感快速路径互不共享提示词和游标
# RUMINATION_BASE_URL=https://your-rumination-provider.example/v1
# RUMINATION_API_KEY=your_rumination_api_key
# RUMINATION_MODEL=your_rumination_model
# 反刍文本提取最大输出 token 数；允许 1024-120000，默认 8192
RUMINATION_MAX_TOKENS=8192
# 反刍每日调度小时（Asia/Shanghai，0-23），默认 6 点
RUMINATION_DAILY_HOUR=6

# 记忆总结（均可选）
# 留空会从 chat_messages 的最新有效记录自动发现
MEMORY_ASSISTANT_ID=
MEMORY_DIGEST_MAX_MESSAGES=60
MEMORY_DIGEST_MAX_CHARS=12000
# 每日计划总结触发小时（0-23），默认凌晨 3 点
MEMORY_DIGEST_DAILY_HOUR=3
MEMORY_DIGEST_IDLE_HOURS=6

# 橘瓣 request_memory 插件（必须使用独立 token，不要填写 Supabase 密钥）
MEMORY_PLUGIN_TOKEN=replace_with_a_long_random_token
MEMORY_REQUEST_RATE_LIMIT=6

# 远程 MCP 记忆服务（与旧插件 token 分离；客户端使用 Authorization: Bearer）
MCP_MEMORY_TOKEN=replace_with_a_different_long_random_token

# 橘瓣待办插件（必须使用另一个独立 token）
TODO_PLUGIN_TOKEN=replace_with_another_long_random_token
TODO_REQUEST_RATE_LIMIT=60

PORT=8000
