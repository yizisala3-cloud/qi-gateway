# 独立示例；不要覆盖原有 .env。默认关闭，缺少账号/凭据不会启动QQ。
QQBOT_ENABLED=false
# 没有开关文件时的初始值；配置页保存后以文件为准。该目录需持久化。
QQBOT_SETTINGS_PATH=data/qqbot-settings.json
QQBOT_TOKEN=
QQBOT_ACCOUNT_ID=
QQBOT_OWNER_ID=
# 与现有手机角色绑定；MEMORY_ASSISTANT_ID 非空时必须相同。
QQBOT_ASSISTANT_ID=
# 下列文件需持久化保存；单个机器人仅一个主动运行实例。
QQBOT_STORE_PATH=data/qqbot.sqlite3
# 不填则没有表情素材，仍可正常文字聊天。文件路径相对网关工作目录。
QQBOT_STICKER_MANIFEST=
# 可选的QQ主提示词文件；现有数据库人格始终经上下文加载。
QQBOT_SYSTEM_PROMPT_FILE=
QQBOT_DEBOUNCE_SECONDS=3
QQBOT_MAX_BATCH_WAIT=10
QQBOT_HISTORY_LIMIT=30
# 远端记忆导出等待上限；超时保留唯一在途任务，私聊不等待导出。
QQBOT_EXPORT_TIMEOUT=15
QQBOT_ACTION_TIMEOUT=15
QQBOT_HEARTBEAT_TIMEOUT=90

# 同样仅作尚未保存配置页设置时的初始值。
QQBOT_PROACTIVE_ENABLED=false
# 真正启用主动消息前须明确填写下面三项；请按自己的生活时区配置。
QQBOT_TIMEZONE=
QQBOT_ACTIVE_START=
QQBOT_ACTIVE_END=
# 以下是未启用情况下的工程示例值，均可调整，不是用户确认的固定频率。
QQBOT_CHECK_SECONDS=300
QQBOT_QUIET_SECONDS=1800
QQBOT_COOLDOWN_SECONDS=3600
QQBOT_DAILY_LIMIT=3
QQBOT_PROACTIVE_TTL=1800
